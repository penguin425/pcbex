(kicad_pcb (version 20250114) (generator pcbex-example)
  (general (thickness 1.6))
  (paper "A4")
  (layers (0 "F.Cu" signal) (31 "B.Cu" signal) (34 "B.Mask" user "b.mask") (35 "F.Mask" user "f.mask") (36 "B.SilkS" user "b.silkscreen") (37 "F.SilkS" user "f.silkscreen") (44 "Edge.Cuts" user))
  (setup (pad_to_mask_clearance 0))
  (net 0 "")
  (net 1 "SIGNAL")
  (footprint "terminal" (layer "F.Cu") (at 5 5)
    (pad "1" thru_hole circle (at 0 0) (size 1.5 1.5) (drill 0.8) (layers "*.Cu" "*.Mask") (net 1 "SIGNAL")))
  (footprint "terminal" (layer "F.Cu") (at 35 15)
    (pad "1" thru_hole circle (at 0 0) (size 1.5 1.5) (drill 0.8) (layers "*.Cu" "*.Mask") (net 1 "SIGNAL")))
  (footprint "obstacle" (layer "F.Cu") (at 20 10)
    (pad "" np_thru_hole rect (at 0 0) (size 8 8) (drill 3) (layers "*.Cu" "*.Mask")))
  (gr_line (start 0 0) (end 40 0) (stroke (width 0.05) (type default)) (layer "Edge.Cuts"))
  (gr_line (start 40 0) (end 40 20) (stroke (width 0.05) (type default)) (layer "Edge.Cuts"))
  (gr_line (start 40 20) (end 10 20) (stroke (width 0.05) (type default)) (layer "Edge.Cuts"))
  (gr_line (start 10 20) (end 0 10) (stroke (width 0.05) (type default)) (layer "Edge.Cuts"))
  (gr_line (start 0 10) (end 0 0) (stroke (width 0.05) (type default)) (layer "Edge.Cuts"))
)
