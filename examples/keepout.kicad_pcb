(kicad_pcb (version 20250114) (generator pcbex-example)
  (general (thickness 1.6))
  (paper "A4")
  (layers (0 "F.Cu" signal) (31 "B.Cu" signal) (34 "B.Mask" user "b.mask") (35 "F.Mask" user "f.mask") (36 "B.SilkS" user "b.silkscreen") (37 "F.SilkS" user "f.silkscreen") (44 "Edge.Cuts" user))
  (setup (pad_to_mask_clearance 0))
  (net 0 "")
  (net 1 "SIGNAL")
  (net_class "Signal" "signal rules"
    (clearance 0.2)
    (trace_width 0.25)
    (via_dia 0.6)
    (via_drill 0.3)
    (add_net "SIGNAL"))
  (footprint "terminal" (layer "F.Cu") (at 5 10)
    (pad "1" thru_hole circle (at 0 0) (size 1.5 1.5) (drill 0.8) (layers "*.Cu" "*.Mask") (net 1 "SIGNAL")))
  (footprint "terminal" (layer "F.Cu") (at 35 10)
    (pad "1" thru_hole circle (at 0 0) (size 1.5 1.5) (drill 0.8) (layers "*.Cu" "*.Mask") (net 1 "SIGNAL")))
  (footprint "rotated-obstacle" (layer "F.Cu") (at 20 4)
    (pad "" np_thru_hole rect (at 0 0 35) (size 6 2) (drill 1) (layers "*.Cu" "*.Mask")))
  (zone (net 0) (net_name "") (layer "F.Cu")
    (keepout (tracks not_allowed) (vias not_allowed) (copperpour not_allowed))
    (polygon (pts (xy 15 4) (xy 25 10) (xy 15 16))))
  (gr_rect (start 0 0) (end 40 20) (stroke (width 0.05) (type default)) (fill none) (layer "Edge.Cuts"))
)
