{
  "schema_version": 1,
  "id": "acme-production-v1",
  "revision": 1,
  "verified_on": "2026-07-29",
  "description": "Example organization policy for PCB and schematic approval",
  "dfm_profile": {
    "schema_version": 1,
    "id": "acme-standard-4layer-v1",
    "aliases": ["acme-4layer"],
    "revision": 1,
    "verified_on": "2026-07-29",
    "description": "Example organization-owned 4-layer manufacturing profile",
    "source_urls": ["https://example.com/hardware/manufacturing-capabilities"],
    "rules": {
      "minimum_track_width_nm": 125000,
      "minimum_clearance_nm": 125000,
      "minimum_drill_nm": 200000,
      "minimum_annular_ring_nm": 150000,
      "minimum_copper_to_edge_nm": 250000,
      "board_thickness_nm": 1600000,
      "maximum_via_aspect_ratio": 8,
      "minimum_drill_to_drill_nm": 250000,
      "allow_via_in_pad": false,
      "minimum_trace_angle_deg": 45
    }
  },
  "electrical_policy": {
    "schema_version": 1,
    "id": "pcbex-default-v1",
    "rules": {
      "coverage_incomplete": {"enabled": true, "severity": "error"},
      "duplicate_reference_unit": {"enabled": true, "severity": "error"},
      "input_not_driven": {"enabled": true, "severity": "warning"},
      "invalid_power_metadata": {"enabled": true, "severity": "error"},
      "missing_decoupling_capacitor": {"enabled": true, "severity": "error"},
      "missing_footprint": {"enabled": true, "severity": "warning"},
      "multiple_net_names": {"enabled": true, "severity": "warning"},
      "multiple_output_drivers": {"enabled": true, "severity": "error"},
      "multiple_power_outputs": {"enabled": true, "severity": "error"},
      "no_connect_connected": {"enabled": true, "severity": "error"},
      "pin_type_no_connect_connected": {"enabled": true, "severity": "error"},
      "power_input_not_driven": {"enabled": true, "severity": "error"},
      "power_input_voltage_exceeded": {"enabled": true, "severity": "error"},
      "power_rail_voltage_conflict": {"enabled": true, "severity": "error"},
      "unannotated_reference": {"enabled": true, "severity": "error"},
      "unconnected_pin": {"enabled": true, "severity": "warning"}
    }
  },
  "ai_requirements": [
    {
      "id": "power",
      "text": "All supply pins have an intentional source and decoupling strategy"
    },
    {
      "id": "safe-state",
      "text": "Reset and enable signals default to a documented safe state"
    }
  ],
  "require_simulation_evidence": true,
